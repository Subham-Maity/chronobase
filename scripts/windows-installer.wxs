<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="ChronoBase"
      Language="1033"
      Version="$(var.AppVersion)"
      Manufacturer="Subham Maity"
      UpgradeCode="D9F4F21E-4D17-4A95-8B29-88F0C42E7B11">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64"
        Description="ChronoBase - Local-first native database backup manager" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ChronoBase.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ChronoBase.ico" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ChronoBase">
          <Component Id="MainExecutable" Guid="B8C4E941-0E8B-40E9-97AA-4D8AC1F0C001" Win64="yes">
            <File Id="ChronoBaseExe" Source="$(var.StageDir)\chronobase.exe" KeyPath="yes" />
            <File Id="ReadmeFile" Source="$(var.StageDir)\README.md" />
            <File Id="LicenseFile" Source="$(var.StageDir)\LICENSE" />
            <File Id="OflFile" Source="$(var.StageDir)\FONT-LICENSE-OFL.txt" />
            <File Id="SlintNoticeFile" Source="$(var.StageDir)\SLINT-ATTRIBUTION.txt" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ChronoBase">
          <Component Id="StartMenuShortcutComponent" Guid="B8C4E941-0E8B-40E9-97AA-4D8AC1F0C002">
            <Shortcut
                Id="StartMenuShortcut"
                Name="ChronoBase"
                Description="Local-first database backup manager for PostgreSQL and MongoDB"
                Target="[INSTALLFOLDER]chronobase.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="ChronoBase.ico" />
            <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\ChronoBase\StartMenu"
                Name="installed"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="DesktopShortcutComponent" Guid="B8C4E941-0E8B-40E9-97AA-4D8AC1F0C003">
          <Shortcut
              Id="DesktopShortcut"
              Name="ChronoBase"
              Description="Local-first database backup manager for PostgreSQL and MongoDB"
              Target="[INSTALLFOLDER]chronobase.exe"
              WorkingDirectory="INSTALLFOLDER"
              Icon="ChronoBase.ico" />
          <RegistryValue
              Root="HKCU"
              Key="Software\ChronoBase\Desktop"
              Name="installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="ChronoBase" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
