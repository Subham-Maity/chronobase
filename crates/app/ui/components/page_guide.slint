// Per-tab Info (i) button and Page Guide modal explaining purpose and setup steps

import { Palette, Type, Space } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { PrimaryButton } from "./buttons.slint";
import { ModalOverlay } from "./modal.slint";

export component PageInfoButton inherits Rectangle {
    in property <string> a11y-label: "Page guide & setup steps";
    callback clicked();

    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 16px;
    background: touch.pressed ? Palette.stone-800
        : touch.has-hover ? Palette.tier-hover
        : Palette.tier-raised;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.line-strong : Palette.line;
    accessible-role: AccessibleRole.button;
    accessible-label: a11y-label;

    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 19px;
        border-width: 2px;
        border-color: Palette.signal;
    }

    Icon {
        x: 9px;
        y: 9px;
        svg-path: Icons.info;
        size: 14px;
        tint: touch.has-hover ? Palette.ink-1 : Palette.ink-2;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PageGuideModal inherits ModalOverlay {
    in property <string> guide-title: "";
    in property <string> guide-purpose: "";
    in property <string> step-1: "";
    in property <string> step-2: "";
    in property <string> step-3: "";
    in property <string> step-4: "";
    callback close();

    modal-width: 500px;
    backdrop-clicked => { root.close(); }

    VerticalLayout {
        spacing: Space.s16;
        alignment: start;

        HorizontalLayout {
            spacing: Space.s12;
            alignment: start;
            Rectangle {
                width: 38px;
                height: 38px;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                border-radius: Palette.r-md;
                background: Palette.signal-dim;
                border-width: 1px;
                border-color: Palette.line-strong;
                Icon {
                    svg-path: Icons.info;
                    tint: Palette.signal;
                    size: 18px;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 2px;
                Text {
                    text: guide-title;
                    font-family: Palette.font-ui;
                    font-size: Type.section;
                    font-weight: 700;
                    color: Palette.ink-1;
                    wrap: word-wrap;
                }
                Text {
                    text: "Purpose & quick setup guide";
                    font-family: Palette.font-ui;
                    font-size: Type.min-label;
                    color: Palette.ink-3;
                }
            }
        }

        Rectangle {
            height: purpose-box.preferred-height;
            vertical-stretch: 0;
            border-radius: Palette.r-md;
            background: Palette.tier-base;
            border-width: 1px;
            border-color: Palette.line;
            purpose-box := VerticalLayout {
                width: parent.width;
                padding: Space.s12;
                Text {
                    text: guide-purpose;
                    font-family: Palette.font-ui;
                    font-size: Type.secondary;
                    color: Palette.ink-2;
                    wrap: word-wrap;
                }
            }
        }

        VerticalLayout {
            spacing: Space.s8;
            if step-1 != "": HorizontalLayout {
                spacing: Space.s12;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    padding-top: 1px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Palette.signal-dim;
                        border-width: 1px;
                        border-color: Palette.line-strong;
                        Text {
                            text: "1";
                            font-family: Palette.font-mono;
                            font-size: Type.min-label;
                            font-weight: 600;
                            color: Palette.signal;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: step-1;
                        font-family: Palette.font-ui;
                        font-size: Type.secondary;
                        color: Palette.ink-2;
                        wrap: word-wrap;
                    }
                }
            }

            if step-2 != "": HorizontalLayout {
                spacing: Space.s12;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    padding-top: 1px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Palette.signal-dim;
                        border-width: 1px;
                        border-color: Palette.line-strong;
                        Text {
                            text: "2";
                            font-family: Palette.font-mono;
                            font-size: Type.min-label;
                            font-weight: 600;
                            color: Palette.signal;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: step-2;
                        font-family: Palette.font-ui;
                        font-size: Type.secondary;
                        color: Palette.ink-2;
                        wrap: word-wrap;
                    }
                }
            }

            if step-3 != "": HorizontalLayout {
                spacing: Space.s12;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    padding-top: 1px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Palette.signal-dim;
                        border-width: 1px;
                        border-color: Palette.line-strong;
                        Text {
                            text: "3";
                            font-family: Palette.font-mono;
                            font-size: Type.min-label;
                            font-weight: 600;
                            color: Palette.signal;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: step-3;
                        font-family: Palette.font-ui;
                        font-size: Type.secondary;
                        color: Palette.ink-2;
                        wrap: word-wrap;
                    }
                }
            }

            if step-4 != "": HorizontalLayout {
                spacing: Space.s12;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    padding-top: 1px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Palette.signal-dim;
                        border-width: 1px;
                        border-color: Palette.line-strong;
                        Text {
                            text: "4";
                            font-family: Palette.font-mono;
                            font-size: Type.min-label;
                            font-weight: 600;
                            color: Palette.signal;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: step-4;
                        font-family: Palette.font-ui;
                        font-size: Type.secondary;
                        color: Palette.ink-2;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Palette.line; }

        HorizontalLayout {
            alignment: end;
            PrimaryButton {
                text: "Got it";
                clicked => { root.close(); }
            }
        }
    }
}

