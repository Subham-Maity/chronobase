export component Icon inherits Path {
    in property <string> svg-path;
    in property <color> tint: Palette.ink-2;
    in property <length> size: 16px;

    width: size;
    height: size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: svg-path;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.75px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Custom ChronoBase brand mark: stacked sediment cylinder + clock arc
export component BrandMark inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: Palette.r-sm;
    background: @linear-gradient(155deg, Palette.stone-800 0%, Palette.stone-950 100%);
    border-width: 1px;
    border-color: Palette.line-strong;

    Path {
        width: 20px;
        height: 20px;
        x: 6px;
        y: 6px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3C7.58 3 4 4.57 4 6.5S7.58 10 12 10s8-1.57 8-3.5S16.42 3 12 3z M4 12c0 1.93 3.58 3.5 8 3.5s8-1.57 8-3.5 M4 17.5C4 19.43 7.58 21 12 21s8-1.57 8-3.5";
        fill: transparent;
        stroke: Palette.ink-1;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    // Ice signal accent dot on top-right
    Rectangle {
        x: 23px;
        y: 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Palette.signal;
    }
}
