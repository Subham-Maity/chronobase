// Schedules page — "Cron Register" with plain-language preset labels and switch control

import { ListView } from "std-widgets.slint";
import { Palette, Type, Space, Motion } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { PrimaryButton, GhostButton, DangerButton } from "../components/buttons.slint";
import { Badge } from "../components/badge.slint";
import { FormField, Chip } from "../components/form_field.slint";
import { Surface } from "../components/surface.slint";
import { PageInfoButton } from "../components/page_guide.slint";

export struct ScheduleRow {
    id: int,
    name: string,
    group-name: string,
    cron-expr: string,
    enabled: bool,
    last-run: string,
}

component ScheduleSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    height: 32px;
    accessible-role: AccessibleRole.switch;
    accessible-label: checked ? "Active" : "Paused";

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 20px;
                border-radius: 10px;
                background: checked ? Palette.ok-dim : Palette.tier-raised;
                border-width: 1px;
                border-color: checked ? Palette.ok : Palette.line-strong;

                animate background { duration: Motion.micro; easing: ease-out; }
                animate border-color { duration: Motion.micro; easing: ease-out; }

                Rectangle {
                    x: checked ? 18px : 3px;
                    y: 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: checked ? Palette.ok : Palette.ink-3;

                    animate x { duration: Motion.micro; easing: ease-out; }
                }
            }
        }

        Text {
            text: checked ? "Active" : "Paused";
            font-family: Palette.font-ui;
            font-size: Type.secondary;
            font-weight: 500;
            color: checked ? Palette.ok : Palette.ink-3;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component SchedulesPage inherits VerticalLayout {
    in property <[ScheduleRow]> rows: [];
    in-out property <bool> retention-enabled: false;
    in-out property <string> retention-keep-last: "";
    in-out property <string> retention-max-age: "";
    in-out property <string> retention-failed-age: "7";
    in-out property <string> retention-freq-kind: "daily";
    in-out property <string> retention-custom-cron: "0 3 * * *";
    in property <string> retention-preview-text: "";
    in property <bool> retention-busy: false;

    callback open-guide();
    callback open-retention-guide();
    callback add-schedule();
    callback toggle-schedule(int);
    callback delete-schedule(int);
    callback save-retention(bool, string, string, string, string, string);
    callback preview-retention(bool, string, string, string, string, string);
    callback run-retention-now();

    padding: Space.s32;
    spacing: Space.s24;

    // Header
    HorizontalLayout {
        alignment: space-between;
        spacing: Space.s16;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            HorizontalLayout {
                alignment: start;
                spacing: Space.s8;
                Text {
                    text: "Schedules";
                    font-family: Palette.font-ui;
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.ink-1;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    width: 32px;
                    horizontal-stretch: 0;
                    alignment: center;
                    PageInfoButton {
                        clicked => { root.open-guide(); }
                    }
                }
            }
            Text {
                text: "Automated local-time cron backups";
                font-family: Palette.font-ui;
                font-size: Type.secondary;
                color: Palette.ink-3;
            }
        }
        VerticalLayout {
            alignment: center;
            PrimaryButton {
                text: "New schedule";
                icon-path: Icons.plus;
                clicked => { root.add-schedule(); }
            }
        }
    }

    Surface {
        vertical-stretch: 1;

        if rows.length == 0: VerticalLayout {
            alignment: center;
            spacing: Space.s12;
            HorizontalLayout {
                alignment: center;
                Icon { svg-path: Icons.clock; tint: Palette.ink-3; size: 28px; }
            }
            Text {
                text: "No schedules yet";
                font-family: Palette.font-ui;
                font-size: Type.body;
                font-weight: 500;
                color: Palette.ink-1;
                horizontal-alignment: center;
            }
            Text {
                text: "Create a cron schedule to back up automatically.";
                font-family: Palette.font-ui;
                font-size: Type.secondary;
                color: Palette.ink-3;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                PrimaryButton {
                    text: "New schedule";
                    icon-path: Icons.plus;
                    clicked => { root.add-schedule(); }
                }
            }
        }

        if rows.length > 0: VerticalLayout {
            Rectangle {
                height: 38px;
                background: Palette.tier-base;
                border-width: 1px;
                border-color: Palette.line;
                HorizontalLayout {
                    padding-left: Space.s16;
                    padding-right: Space.s16;
                    spacing: Space.s12;
                    Text { text: "Schedule"; horizontal-stretch: 2; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Target"; horizontal-stretch: 1; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Cadence"; horizontal-stretch: 2; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "State"; width: 108px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Last run"; horizontal-stretch: 2; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: ""; width: 40px; }
                }
            }

            ListView {
                vertical-stretch: 1;
                for row in rows: Rectangle {
                    height: 58px;
                    border-width: 1px;
                    border-color: Palette.row-divider;

                    HorizontalLayout {
                        padding-left: Space.s16;
                        padding-right: Space.s16;
                        spacing: Space.s12;

                        Text {
                            text: row.name;
                            horizontal-stretch: 2;
                            font-family: Palette.font-ui;
                            font-size: Type.body;
                            font-weight: 500;
                            color: Palette.ink-1;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            VerticalLayout { alignment: center; Badge { text: row.group-name; variant: "group"; } }
                        }

                        VerticalLayout {
                            horizontal-stretch: 2;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: row.cron-expr;
                                font-family: Palette.font-mono;
                                font-size: Type.secondary;
                                color: Palette.ink-1;
                            }
                            Text {
                                text: row.cron-expr == "0 2 * * *" ? "Daily at 2:00 AM"
                                    : row.cron-expr == "0 */6 * * *" ? "Every 6 hours"
                                    : row.cron-expr == "0 * * * *" ? "Every hour"
                                    : row.cron-expr == "0 2 * * 0" ? "Weekly on Sunday"
                                    : row.cron-expr == "0 2 1 * *" ? "Monthly on the 1st"
                                    : "Custom cron";
                                font-family: Palette.font-ui;
                                font-size: Type.min-label;
                                color: Palette.ink-3;
                            }
                        }

                        VerticalLayout {
                            width: 108px;
                            alignment: center;
                            ScheduleSwitch {
                                checked: row.enabled;
                                toggled => { root.toggle-schedule(row.id); }
                            }
                        }

                        Text {
                            text: row.last-run;
                            horizontal-stretch: 2;
                            font-family: Palette.font-ui;
                            font-size: Type.secondary;
                            color: Palette.ink-3;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            width: 40px;
                            alignment: end;
                            VerticalLayout {
                                alignment: center;
                                DangerButton {
                                    icon-path: Icons.trash;
                                    small: true;
                                    a11y-label: "Delete schedule " + row.name;
                                    clicked => { root.delete-schedule(row.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Automatic Backup Retention Card
    Surface {
        VerticalLayout {
            padding: Space.s16;
            spacing: Space.s12;

            HorizontalLayout {
                alignment: space-between;
                spacing: Space.s12;

                HorizontalLayout {
                    spacing: Space.s8;
                    alignment: start;
                    Text {
                        text: "Automatic Retention";
                        font-family: Palette.font-ui;
                        font-size: Type.section;
                        font-weight: 600;
                        color: Palette.ink-1;
                        vertical-alignment: center;
                    }
                    PageInfoButton {
                        clicked => { root.open-retention-guide(); }
                    }
                }

                ScheduleSwitch {
                    checked: retention-enabled;
                    toggled => {
                        retention-enabled = !retention-enabled;
                        root.save-retention(
                            retention-enabled,
                            retention-keep-last,
                            retention-max-age,
                            retention-failed-age,
                            retention-freq-kind,
                            retention-custom-cron
                        );
                    }
                }
            }

            Text {
                text: "Keep-last and max-age are both limits; the newest good backup per database is always kept.";
                font-family: Palette.font-ui;
                font-size: Type.min-label;
                color: Palette.ink-3;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Space.s12;
                FormField {
                    horizontal-stretch: 1;
                    label: "Keep last (count)";
                    value <=> retention-keep-last;
                    mono: true;
                    placeholder: "e.g. 14 (blank = off)";
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Max age (days)";
                    value <=> retention-max-age;
                    mono: true;
                    placeholder: "e.g. 30 (blank = off)";
                }
                FormField {
                    horizontal-stretch: 1;
                    label: "Failed age (days)";
                    value <=> retention-failed-age;
                    mono: true;
                    placeholder: "7";
                }
            }

            HorizontalLayout {
                spacing: Space.s8;
                alignment: start;
                Text {
                    text: "Cleanup cadence:";
                    font-family: Palette.font-ui;
                    font-size: Type.min-label;
                    color: Palette.ink-3;
                    vertical-alignment: center;
                }
                Chip {
                    text: "Daily";
                    selected: retention-freq-kind == "daily";
                    clicked => { retention-freq-kind = "daily"; }
                }
                Chip {
                    text: "Weekly";
                    selected: retention-freq-kind == "weekly";
                    clicked => { retention-freq-kind = "weekly"; }
                }
                Chip {
                    text: "Monthly";
                    selected: retention-freq-kind == "monthly";
                    clicked => { retention-freq-kind = "monthly"; }
                }
                Chip {
                    text: "Custom";
                    selected: retention-freq-kind == "custom";
                    clicked => { retention-freq-kind = "custom"; }
                }
                if retention-freq-kind == "custom": FormField {
                    width: 170px;
                    value <=> retention-custom-cron;
                    mono: true;
                    placeholder: "0 3 * * *";
                }
            }

            HorizontalLayout {
                alignment: space-between;
                spacing: Space.s12;

                Text {
                    text: retention-preview-text;
                    horizontal-stretch: 1;
                    font-family: Palette.font-ui;
                    font-size: Type.secondary;
                    color: Palette.signal;
                    vertical-alignment: center;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: Space.s8;
                    GhostButton {
                        text: "Preview";
                        enabled: !retention-busy;
                        clicked => {
                            root.preview-retention(
                                retention-enabled,
                                retention-keep-last,
                                retention-max-age,
                                retention-failed-age,
                                retention-freq-kind,
                                retention-custom-cron
                            );
                        }
                    }
                    GhostButton {
                        text: "Save policy";
                        enabled: !retention-busy;
                        clicked => {
                            root.save-retention(
                                retention-enabled,
                                retention-keep-last,
                                retention-max-age,
                                retention-failed-age,
                                retention-freq-kind,
                                retention-custom-cron
                            );
                        }
                    }
                    DangerButton {
                        text: retention-busy ? "Cleaning..." : "Run cleanup now";
                        enabled: !retention-busy;
                        clicked => { root.run-retention-now(); }
                    }
                }
            }
        }
    }
}
