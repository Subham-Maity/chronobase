// Connections page — Unified Grouped Ledger for Direct Connections and VPS Pull Peers

import { ScrollView } from "std-widgets.slint";
import { Palette, Type, Space } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { PrimaryButton, GhostButton, DangerButton, WipeButton } from "../components/buttons.slint";
import { Badge } from "../components/badge.slint";
import { CycleButton } from "../components/form_field.slint";
import { Surface } from "../components/surface.slint";
import { PageInfoButton } from "../components/page_guide.slint";

export struct ConnectionRow {
    id: int,
    origin: string,
    name: string,
    group-name: string,
    db-type: string,
    masked-url: string,
    endpoint: string,
    target-label: string,
}

export component ConnectionsPage inherits VerticalLayout {
    in property <[ConnectionRow]> rows: [];
    in property <string> group-filter-label: "All Groups";
    in property <string> type-filter-label: "All Types";
    in property <bool> backup-group-busy: false;

    callback open-guide();
    callback add-connection();
    callback add-vps();
    callback cycle-group-filter();
    callback cycle-type-filter();
    callback backup-group();
    callback backup-one(string, int);
    callback edit-one(string, int);
    callback wipe-one(int);
    callback delete-one(string, int);

    property <bool> compact: root.width < 820px;

    padding: Space.s32;
    spacing: Space.s24;

    // Header
    HorizontalLayout {
        alignment: space-between;
        spacing: Space.s16;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            HorizontalLayout {
                alignment: start;
                spacing: Space.s8;
                Text {
                    text: "Connections";
                    font-family: Palette.font-ui;
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.ink-1;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    width: 32px;
                    horizontal-stretch: 0;
                    alignment: center;
                    PageInfoButton {
                        clicked => { root.open-guide(); }
                    }
                }
            }
            Text {
                text: "Direct databases and encrypted VPS Pull targets organised by group for cron schedules";
                font-family: Palette.font-ui;
                font-size: Type.secondary;
                color: Palette.ink-3;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Space.s8;
            VerticalLayout {
                alignment: center;
                GhostButton {
                    text: "Add VPS";
                    icon-path: Icons.download;
                    clicked => { root.add-vps(); }
                }
            }
            VerticalLayout {
                alignment: center;
                PrimaryButton {
                    text: "Add connection";
                    icon-path: Icons.plus;
                    clicked => { root.add-connection(); }
                }
            }
        }
    }

    // Toolbar
    HorizontalLayout {
        spacing: Space.s12;
        alignment: start;
        CycleButton {
            label: group-filter-label;
            clicked => { root.cycle-group-filter(); }
        }
        CycleButton {
            label: type-filter-label;
            clicked => { root.cycle-type-filter(); }
        }
        GhostButton {
            text: backup-group-busy ? "Backing up..." : "Back up group";
            icon-path: Icons.bolt;
            small: true;
            enabled: !backup-group-busy;
            clicked => { root.backup-group(); }
        }
    }

    // Grouped ledger
    Surface {
        vertical-stretch: 1;

        if rows.length == 0: VerticalLayout {
            alignment: center;
            spacing: Space.s12;
            HorizontalLayout {
                alignment: center;
                Icon { svg-path: Icons.database; tint: Palette.ink-3; size: 28px; }
            }
            Text {
                text: "No connections yet";
                font-family: Palette.font-ui;
                font-size: Type.body;
                font-weight: 500;
                color: Palette.ink-1;
                horizontal-alignment: center;
            }
            Text {
                text: "Add a PostgreSQL/MongoDB connection URL or a VPS Pull peer to begin.";
                font-family: Palette.font-ui;
                font-size: Type.secondary;
                color: Palette.ink-3;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                spacing: Space.s12;
                PrimaryButton {
                    text: "Add connection";
                    icon-path: Icons.plus;
                    clicked => { root.add-connection(); }
                }
                GhostButton {
                    text: "Add VPS";
                    icon-path: Icons.download;
                    clicked => { root.add-vps(); }
                }
            }
        }

        if rows.length > 0: VerticalLayout {
            Rectangle {
                height: 38px;
                background: Palette.tier-base;
                border-width: 1px;
                border-color: Palette.line;
                HorizontalLayout {
                    padding-left: Space.s16;
                    padding-right: Space.s16;
                    spacing: Space.s12;
                    Text { text: "Database"; horizontal-stretch: 2; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Source & Engine"; width: 176px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    if !compact: Text { text: "Connection / Endpoint URL"; horizontal-stretch: 3; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Actions"; width: 248px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;

                    for row[idx] in rows: VerticalLayout {
                        if idx == 0 || row.group-name != rows[idx - 1].group-name: Rectangle {
                            height: 32px;
                            background: Palette.tier-raised;
                            border-width: 1px;
                            border-color: Palette.row-divider;
                            HorizontalLayout {
                                padding-left: Space.s16;
                                padding-right: Space.s16;
                                Text {
                                    text: row.group-name;
                                    font-family: Palette.font-ui;
                                    font-size: Type.min-label;
                                    font-weight: 600;
                                    color: Palette.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 52px;
                            border-width: 1px;
                            border-color: Palette.row-divider;

                            HorizontalLayout {
                                padding-left: Space.s16;
                                padding-right: Space.s16;
                                spacing: Space.s12;

                                VerticalLayout {
                                    horizontal-stretch: 2;
                                    min-width: 0px;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.name;
                                        font-family: Palette.font-ui;
                                        font-size: Type.body;
                                        font-weight: 500;
                                        color: Palette.ink-1;
                                        overflow: elide;
                                    }
                                    if row.origin == "vps": Text {
                                        text: row.target-label;
                                        font-family: Palette.font-ui;
                                        font-size: 11px;
                                        color: Palette.signal;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    width: 176px;
                                    alignment: start;
                                    spacing: 6px;
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: row.origin == "vps" ? "VPS" : "Direct";
                                            variant: row.origin == "vps" ? "group" : "success";
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: row.db-type == "postgres" ? "Postgres" : "MongoDB";
                                            variant: row.db-type == "postgres" ? "pg" : "mongo";
                                        }
                                    }
                                }

                                if !compact: Text {
                                    text: row.masked-url;
                                    horizontal-stretch: 3;
                                    min-width: 0px;
                                    font-family: Palette.font-mono;
                                    font-size: Type.min-label;
                                    color: Palette.ink-3;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    width: 248px;
                                    horizontal-stretch: 0;
                                    spacing: 6px;
                                    alignment: end;

                                    VerticalLayout {
                                        alignment: center;
                                        PrimaryButton {
                                            text: row.origin == "vps" ? "Pull" : "Back up";
                                            icon-path: row.origin == "vps" ? Icons.download : Icons.bolt;
                                            small: true;
                                            a11y-label: "Back up " + row.name;
                                            clicked => { root.backup-one(row.origin, row.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        GhostButton {
                                            icon-path: Icons.edit;
                                            small: true;
                                            a11y-label: "Edit " + row.name;
                                            clicked => { root.edit-one(row.origin, row.id); }
                                        }
                                    }
                                    if row.origin == "direct": VerticalLayout {
                                        alignment: center;
                                        WipeButton {
                                            text: "Wipe";
                                            a11y-label: "Wipe database " + row.name;
                                            clicked => { root.wipe-one(row.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        DangerButton {
                                            icon-path: Icons.trash;
                                            small: true;
                                            a11y-label: "Delete " + row.name;
                                            clicked => { root.delete-one(row.origin, row.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
