// Backups page — Group & Date organized snapshot ledger + Folder Reveal action + error strip

import { ScrollView } from "std-widgets.slint";
import { Palette, Type, Space } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { GhostButton, DangerButton } from "../components/buttons.slint";
import { Badge } from "../components/badge.slint";
import { CycleButton, Chip } from "../components/form_field.slint";
import { Surface } from "../components/surface.slint";
import { PageInfoButton } from "../components/page_guide.slint";

export struct BackupRow {
    id: int,
    connection-name: string,
    group-name: string,
    date-group: string,
    file-name: string,
    source-kind: string,
    db-type: string,
    status: string,
    missing-on-disk: bool,
    error-msg: string,
    size-text: string,
    when-text: string,
    exact-time: string,
}

export component BackupsPage inherits VerticalLayout {
    in property <[BackupRow]> rows: [];
    in property <string> group-filter-label: "All Groups";
    in property <string> type-filter-label: "All Types";
    in property <string> status-filter-label: "All Status";
    in-out property <bool> grouped-by-date: true;

    in-out property <int> selected-error-id: -1;
    in-out property <string> selected-error-msg: "";
    in-out property <string> selected-error-name: "";

    callback open-guide();
    callback cycle-group-filter();
    callback cycle-type-filter();
    callback cycle-status-filter();
    callback toggle-grouped-view(bool);
    callback reveal-backup(int);
    callback open-restore(int);
    callback delete-backup(int);

    property <bool> compact: root.width < 820px;

    padding: Space.s32;
    spacing: Space.s24;

    // Header
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            alignment: start;
            spacing: Space.s8;
            Text {
                text: "Backups";
                font-family: Palette.font-ui;
                font-size: Type.title;
                font-weight: 600;
                color: Palette.ink-1;
                horizontal-stretch: 0;
            }
            VerticalLayout {
                width: 32px;
                horizontal-stretch: 0;
                alignment: center;
                PageInfoButton {
                    clicked => { root.open-guide(); }
                }
            }
        }
        Text {
            text: "Snapshots organized by group and date — all successful snapshots kept until deleted or cleaned by retention";
            font-family: Palette.font-ui;
            font-size: Type.secondary;
            color: Palette.ink-3;
        }
    }

    // Toolbar
    HorizontalLayout {
        spacing: Space.s12;
        alignment: space-between;
        HorizontalLayout {
            spacing: Space.s12;
            alignment: start;
            CycleButton {
                label: group-filter-label;
                clicked => { root.cycle-group-filter(); }
            }
            CycleButton {
                label: type-filter-label;
                clicked => { root.cycle-type-filter(); }
            }
            CycleButton {
                label: status-filter-label;
                clicked => { root.cycle-status-filter(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Chip {
                text: "Group & Date";
                selected: grouped-by-date;
                clicked => {
                    grouped-by-date = true;
                    root.toggle-grouped-view(true);
                }
            }
            Chip {
                text: "Timeline";
                selected: !grouped-by-date;
                clicked => {
                    grouped-by-date = false;
                    root.toggle-grouped-view(false);
                }
            }
        }
    }

    // Group + Date ledger
    Surface {
        vertical-stretch: 1;

        if rows.length == 0: VerticalLayout {
            alignment: center;
            spacing: Space.s12;
            HorizontalLayout {
                alignment: center;
                Icon { svg-path: Icons.archive; tint: Palette.ink-3; size: 28px; }
            }
            Text {
                text: "No snapshots match your filter";
                font-family: Palette.font-ui;
                font-size: Type.body;
                font-weight: 500;
                color: Palette.ink-1;
                horizontal-alignment: center;
            }
            Text {
                text: "Try clearing one of the filters or run a manual backup.";
                font-family: Palette.font-ui;
                font-size: Type.secondary;
                color: Palette.ink-3;
                horizontal-alignment: center;
            }
        }

        if rows.length > 0: VerticalLayout {
            Rectangle {
                height: 38px;
                background: Palette.tier-base;
                border-width: 1px;
                border-color: Palette.line;
                HorizontalLayout {
                    padding-left: Space.s16;
                    padding-right: Space.s16;
                    spacing: Space.s12;
                    Text { text: "Snapshot & File"; horizontal-stretch: 3; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Engine"; width: 100px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Status"; width: 104px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Size"; width: 72px; horizontal-alignment: right; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    if !compact: Text { text: "Saved"; width: 126px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                    Text { text: "Actions"; width: 184px; font-family: Palette.font-ui; font-size: Type.min-label; font-weight: 500; color: Palette.ink-3; vertical-alignment: center; }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;

                    for row[idx] in rows: VerticalLayout {
                        if grouped-by-date && (idx == 0 || row.date-group != rows[idx - 1].date-group): Rectangle {
                            height: 32px;
                            background: Palette.tier-raised;
                            border-width: 1px;
                            border-color: Palette.row-divider;
                            HorizontalLayout {
                                padding-left: Space.s16;
                                padding-right: Space.s16;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { svg-path: Icons.folder; tint: Palette.signal; size: 13px; }
                                }
                                Text {
                                    text: row.date-group;
                                    font-family: Palette.font-ui;
                                    font-size: Type.min-label;
                                    font-weight: 600;
                                    color: Palette.ink-2;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 54px;
                            background: row.id == selected-error-id ? Palette.bad-dim : transparent;
                            border-width: 1px;
                            border-color: Palette.row-divider;

                            HorizontalLayout {
                                padding-left: Space.s16;
                                padding-right: Space.s16;
                                spacing: Space.s12;

                                VerticalLayout {
                                    horizontal-stretch: 3;
                                    min-width: 0px;
                                    alignment: center;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: row.connection-name;
                                            font-family: Palette.font-ui;
                                            font-size: Type.body;
                                            font-weight: 500;
                                            color: Palette.ink-1;
                                            overflow: elide;
                                            min-width: 0px;
                                        }
                                        if !grouped-by-date: Badge {
                                            text: row.group-name;
                                            variant: "group";
                                        }
                                    }
                                    Text {
                                        text: row.source-kind + " · " + row.file-name;
                                        font-family: Palette.font-mono;
                                        font-size: Type.min-label;
                                        color: Palette.ink-3;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    width: 100px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: row.db-type == "postgres" ? "Postgres" : "MongoDB";
                                            variant: row.db-type == "postgres" ? "pg" : "mongo";
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    width: 104px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            text: row.missing-on-disk ? "Missing"
                                                : row.status == "success" ? "Succeeded"
                                                : "Failed";
                                            variant: row.missing-on-disk ? "amber" : row.status;
                                        }
                                    }
                                }

                                Text {
                                    text: row.size-text;
                                    width: 72px;
                                    horizontal-alignment: right;
                                    font-family: Palette.font-mono;
                                    font-size: Type.secondary;
                                    color: Palette.ink-2;
                                    vertical-alignment: center;
                                }

                                if !compact: VerticalLayout {
                                    width: 126px;
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: row.when-text;
                                        font-family: Palette.font-ui;
                                        font-size: Type.secondary;
                                        color: Palette.ink-2;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.exact-time;
                                        font-family: Palette.font-mono;
                                        font-size: 11px;
                                        color: Palette.ink-3;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    width: 184px;
                                    horizontal-stretch: 0;
                                    spacing: 6px;
                                    alignment: end;

                                    if row.status == "success" && !row.missing-on-disk: VerticalLayout {
                                        alignment: center;
                                        GhostButton {
                                            icon-path: Icons.folder;
                                            small: true;
                                            a11y-label: "Open folder for " + row.file-name;
                                            clicked => { root.reveal-backup(row.id); }
                                        }
                                    }

                                    if row.status == "success" && !row.missing-on-disk: VerticalLayout {
                                        alignment: center;
                                        GhostButton {
                                            text: "Restore";
                                            icon-path: Icons.restore;
                                            small: true;
                                            a11y-label: "Restore snapshot for " + row.connection-name;
                                            clicked => { root.open-restore(row.id); }
                                        }
                                    }

                                    if row.status == "failed" && row.error-msg != "": VerticalLayout {
                                        alignment: center;
                                        GhostButton {
                                            text: row.id == selected-error-id ? "Hide" : "Error";
                                            small: true;
                                            a11y-label: "Inspect error for " + row.connection-name;
                                            clicked => {
                                                if (selected-error-id == row.id) {
                                                    selected-error-id = -1;
                                                    selected-error-msg = "";
                                                    selected-error-name = "";
                                                } else {
                                                    selected-error-id = row.id;
                                                    selected-error-msg = row.error-msg;
                                                    selected-error-name = row.connection-name + " (" + row.exact-time + ")";
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        DangerButton {
                                            icon-path: Icons.trash;
                                            small: true;
                                            a11y-label: "Delete backup for " + row.connection-name;
                                            clicked => { root.delete-backup(row.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Fixed detail strip for inspecting failed backup errors
    if selected-error-id >= 0 && selected-error-msg != "": Rectangle {
        height: 68px;
        clip: true;
        border-radius: Palette.r-md;
        background: Palette.bad-dim;
        border-width: 1px;
        border-color: Palette.bad-border;

        HorizontalLayout {
            padding-left: Space.s16;
            padding-right: Space.s12;
            spacing: Space.s12;

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 4px;

                Text {
                    text: "Failure details — " + selected-error-name;
                    font-family: Palette.font-ui;
                    font-size: Type.min-label;
                    font-weight: 600;
                    color: Palette.bad;
                }

                TextInput {
                    text: selected-error-msg;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    single-line: true;
                    read-only: true;
                    font-family: Palette.font-mono;
                    font-size: Type.min-label;
                    color: Palette.ink-1;
                    selection-background-color: Palette.signal-dim;
                }
            }

            VerticalLayout {
                horizontal-stretch: 0;
                alignment: center;
                GhostButton {
                    icon-path: Icons.close;
                    small: true;
                    a11y-label: "Close error details";
                    clicked => {
                        selected-error-id = -1;
                        selected-error-msg = "";
                    }
                }
            }
        }
    }
}
